---
const { title = 'The Working Margin', description = 'Writing by Bagus Bachtiar' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">THE WORKING MARGIN</a>
      <nav>
        <a href="/writing/">Writing</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Bagus Bachtiar</span>
      <span>Notes on energy, climate, impact, growth & ideas.</span>
    </footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Baskerville:wght@400;700&display=swap');

  :root {
    --ink: #181818;
    --muted: #707070;
    --line: #deddd8;
    --paper: #f7f6f1;
    --accent: #7a4e2d;
    --max: 1080px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "DM Sans", system-ui, sans-serif;
    line-height: 1.7;
  }

  a { color: inherit; text-decoration: none; }
  a:hover { opacity: .65; }

  .site-header {
    max-width: var(--max);
    margin: 0 auto;
    padding: 28px 28px 22px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-size: .82rem;
    letter-spacing: .16em;
    font-weight: 600;
  }

  nav { display: flex; gap: 26px; font-size: .9rem; }
  main { max-width: var(--max); margin: 0 auto; padding: 0 28px; }

  h1, h2, h3 {
    font-family: "Libre Baskerville", Georgia, serif;
    font-weight: 400;
    line-height: 1.25;
  }

  .site-footer {
    max-width: var(--max);
    margin: 90px auto 0;
    padding: 24px 28px 40px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font-size: .78rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .72rem;
    color: var(--muted);
  }

  .article-body {
    max-width: 720px;
    font-size: 1.05rem;
  }

  .article-body h2 {
    margin-top: 2.4em;
    font-size: 1.55rem;
  }

  .article-body blockquote {
    margin: 2rem 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--accent);
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 1.15rem;
  }

  @media (max-width: 650px) {
    .site-header { padding: 22px 18px; }
    main { padding: 0 18px; }
    .site-footer { margin-top: 60px; padding: 22px 18px 32px; flex-direction: column; }
    nav { gap: 16px; }
  }
</style>
