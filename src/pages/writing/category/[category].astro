---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);

  const categories = [...new Set(posts.map((post) => post.data.category))];

  return categories.map((category) => ({
    params: { category },
    props: {
      posts: posts
        .filter((post) => post.data.category === category)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    }
  }));
}

const { posts } = Astro.props;
const { category } = Astro.params;
---

<BaseLayout
  title={`${category} — The Working Margin`}
  description={`Writing by Bagus Bachtiar on ${category}.`}
>
  <section class="page-head">
    <p class="eyebrow">Category</p>
    <h1>{category}</h1>
    <p>Writing and working notes in this area.</p>
  </section>

  <section class="list">
    {posts.map((post) => (
      <article>
        <div class="meta">
          {post.data.category} · {post.data.date.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          })}
        </div>

        <h2>
          <a href={`/writing/${post.id}/`}>
            {post.data.title}
          </a>
        </h2>

        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 80px 0 50px;
    max-width: 700px;
  }

  .page-head h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    margin: 12px 0;
  }

  .page-head p:last-child {
    color: var(--muted);
    font-size: 1.1rem;
  }

  .list article {
    max-width: 820px;
    padding: 35px 0;
    border-bottom: 1px solid var(--line);
  }

  .meta {
    color: var(--muted);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  h2 {
    font-size: 1.8rem;
    margin: 10px 0;
  }

  .list p {
    color: var(--muted);
  }
</style>
