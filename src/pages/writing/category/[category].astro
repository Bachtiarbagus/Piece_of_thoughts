---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const categories = ['Energy & Climate', 'Impact', 'Personal Development', 'Essays & Ideas'];
export async function getStaticPaths() {
  return categories.map((category) => ({ params: { category }, props: { category } }));
}
const { category } = Astro.props;
const posts = (await getCollection('writing', ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`${category} — The Working Margin`}>
  <section class="page-head">
    <p class="eyebrow">Category</p>
    <h1>{category}</h1>
    <a href="/writing/">← All writing</a>
  </section>
  <section class="list">
    {posts.length ? posts.map((post) => (
      <article>
        <div class="meta">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
        <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    )) : <p class="empty">No pieces here yet. More to come.</p>}
  </section>
</BaseLayout>
<style>
  .page-head { padding:80px 0 48px; }
  .page-head h1 { font-size:clamp(2.8rem,6vw,5rem); margin:12px 0 20px; letter-spacing:-.04em; }
  .page-head a { color:var(--muted); font-size:.85rem; }
  .list article { max-width:820px; padding:34px 0; border-bottom:1px solid var(--line); }
  .meta { color:var(--muted); font-size:.69rem; text-transform:uppercase; letter-spacing:.1em; }
  .list h2 { font-size:1.85rem; margin:9px 0; }
  .list p { color:var(--muted); margin:0; }
  .empty { padding:30px 0; }
</style>
