---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing — The Working Margin">

  <section class="head">
    <p class="eyebrow">The archive</p>

    <h1>Writing</h1>

    <p>
      Essays, observations and working notes across four areas.
    </p>
  </section>

  <div class="categories">
    {[
      'Energy & Climate',
      'Impact',
      'Personal Development',
      'Essays & Ideas'
    ].map(category => (
      <a href={`/writing/category/${encodeURIComponent(category)}/`}>
        {category}
      </a>
    ))}
  </div>

  <section class="list">
    {posts.map(post => (
      <article>
        <div class="meta">
          {post.data.category} ·
          {post.data.date.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          })}
        </div>

        <h2>
          <a href={`/writing/${post.id}/`}>
            {post.data.title}
          </a>
        </h2>

        <p>{post.data.description}</p>
      </article>
    ))}
  </section>

</BaseLayout>

<style>
.head {
  padding: 80px 0 50px;
  max-width: 700px;
}

.head h1 {
  font-size: clamp(3rem, 7vw, 5rem);
  margin: 12px 0;
}

.head p:last-child {
  color: var(--muted);
  font-size: 1.1rem;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  padding-bottom: 35px;
  border-bottom: 1px solid var(--line);
}

.categories a {
  border: 1px solid var(--line);
  padding: 7px 12px;
  border-radius: 999px;
  font-size: .75rem;
}

.list article {
  max-width: 850px;
  padding: 35px 0;
  border-bottom: 1px solid var(--line);
}

.list h2 {
  font-size: 1.85rem;
  margin: 9px 0;
}

.list p {
  color: var(--muted);
  margin: 0;
}
</style>
