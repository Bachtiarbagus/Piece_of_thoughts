---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['Energy & Climate', 'Impact', 'Personal Development', 'Essays & Ideas'];
---
<BaseLayout title="Writing — The Working Margin">
  <section class="page-head">
    <p class="eyebrow">The archive</p>
    <h1>Writing</h1>
    <p>Essays, observations and working notes. New pieces are added as they are written.</p>
  </section>

  <div class="categories">
    {categories.map((category) => <a href={`/writing/category/${encodeURIComponent(category)}/`} class="tag">{category}</a>)}
  </div>

  <section class="list">
    {posts.map((post) => (
      <article>
        <div class="meta">{post.data.category} · {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
        <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head { padding:80px 0 48px; max-width:720px; }
  .page-head h1 { font-size:clamp(3rem,7vw,5rem); margin:12px 0; letter-spacing:-.04em; }
  .page-head p:last-child { color:var(--muted); font-size:1.08rem; }
  .categories { display:flex; flex-wrap:wrap; gap:10px; padding-bottom:35px; border-bottom:1px solid var(--line); }
  .list article { max-width:820px; padding:34px 0; border-bottom:1px solid var(--line); }
  .meta { color:var(--muted); font-size:.69rem; text-transform:uppercase; letter-spacing:.1em; }
  .list h2 { font-size:1.85rem; margin:9px 0; }
  .list p { color:var(--muted); margin:0; }
</style>
