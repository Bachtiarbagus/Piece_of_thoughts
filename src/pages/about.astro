---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — The Working Margin">
  <section class="about">
    <p class="eyebrow">About the author</p>

    <h1>
      Bagus<br />
      <em>Bachtiar</em>
    </h1>

    <div class="copy">
      <p>
        I work across energy, sustainability, infrastructure and development.
        The Working Margin is where I put ideas that don't fit neatly into a
        slide deck, a project brief or a job description.
      </p>

      <p>
        I write about <strong>energy & climate, impact, personal development,
        and essays & ideas</strong>—sometimes from professional experience,
        sometimes from research, and sometimes simply because a question
        refuses to go away.
      </p>

      <p>
        The aim is not to present finished answers. It is to make better
        questions, think in public, and keep a record of what I am learning.
      </p>

      <div class="links">
        <a href="https://www.linkedin.com/">LinkedIn ↗</a>
        <a href="mailto:hello@example.com">Email ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.about {
  padding: 90px 0 30px;
}

.about h1 {
  font-size: clamp(3.4rem, 8vw, 6rem);
  letter-spacing: -.05em;
  line-height: 1.05;
  margin: 15px 0 65px;
}

.about h1 em {
  color: var(--accent);
  font-style: normal;
}

.copy {
  max-width: 720px;
  font-size: 1.12rem;
}

.copy p {
  margin: 0 0 1.7em;
}

.links {
  display: flex;
  gap: 28px;
  margin-top: 55px;
  font-size: .85rem;
}

.links a {
  text-decoration: underline;
  text-underline-offset: 4px;
}
</style>
