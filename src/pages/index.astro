---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const categories = ['Energy & Climate', 'Impact', 'Personal Development', 'Essays & Ideas'];
---
<BaseLayout title="The Working Margin — Bagus Bachtiar" description="Writing by Bagus Bachtiar on energy, climate, impact, personal development, essays and ideas.">
  <section class="hero">
    <div>
      <p class="eyebrow">Writing by Bagus Bachtiar</p>
      <h1>The Working<br /><em>Margin</em></h1>
      <p class="intro">Notes on energy, climate, impact, growth, and the ideas in between.</p>
    </div>
    <div class="hero-note">
      <span>01</span>
      <p>A personal publication about trying to understand complicated things without pretending they are simple.</p>
    </div>
  </section>

  {featured && (
    <section class="featured">
      <div class="section-label">Featured</div>
      <a href={`/writing/${featured.id}/`} class="featured-link">
        <div>
          <div class="meta">{featured.data.category} · {featured.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
        </div>
        <span class="arrow">↗</span>
      </a>
    </section>
  )}

  <section class="archive-preview">
    <div class="section-head">
      <h2>Latest writing</h2>
      <a href="/writing/">View archive →</a>
    </div>
    <div class="articles">
      {latest.map((post) => (
        <article class="article-card">
          <div class="meta">{post.data.category} · {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</div>
          <h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="areas">
    <div class="section-label">Writing across</div>
    <div class="area-grid">
      {categories.map((category, i) => (
        <a href={`/writing/category/${encodeURIComponent(category)}/`} class="area">
          <span>0{i + 1}</span>
          <strong>{category}</strong>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 90px 0 85px; display:grid; grid-template-columns: 1.45fr .55fr; gap:70px; align-items:end; }
  .hero h1 { font-size: clamp(3.8rem, 9vw, 7.1rem); margin: 15px 0 24px; letter-spacing:-.055em; }
  .hero h1 em { color:var(--accent); font-style:normal; }
  .intro { max-width:560px; color:var(--muted); font-size:1.18rem; margin:0; }
  .hero-note { border-left:1px solid var(--line); padding-left:25px; color:var(--muted); font-size:.86rem; }
  .hero-note span { color:var(--accent); font-size:.72rem; }
  .featured, .archive-preview, .areas { border-top:1px solid var(--line); padding:48px 0 0; }
  .featured-link { display:grid; grid-template-columns:1fr auto; gap:25px; padding:20px 0 50px; }
  .meta { color:var(--muted); font-size:.69rem; text-transform:uppercase; letter-spacing:.1em; }
  .featured h2 { font-size:clamp(2rem,4.5vw,3.6rem); max-width:820px; margin:13px 0; letter-spacing:-.025em; }
  .featured p { color:var(--muted); max-width:700px; margin:0; }
  .arrow { font-size:1.7rem; }
  .section-label { color:var(--muted); font-size:.7rem; text-transform:uppercase; letter-spacing:.14em; }
  .section-head { display:flex; justify-content:space-between; align-items:baseline; }
  .section-head h2 { font-size:1.65rem; }
  .section-head a { color:var(--muted); font-size:.8rem; }
  .articles { margin-top:12px; }
  .article-card { max-width:820px; padding:28px 0; border-bottom:1px solid var(--line); }
  .article-card h3 { font-size:1.55rem; margin:8px 0; }
  .article-card p { color:var(--muted); margin:0; }
  .areas { margin-top:70px; padding-bottom:20px; }
  .area-grid { display:grid; grid-template-columns:1fr 1fr; margin-top:25px; border-top:1px solid var(--line); }
  .area { display:grid; grid-template-columns:45px 1fr auto; gap:15px; align-items:center; padding:22px 0; border-bottom:1px solid var(--line); font-size:.92rem; }
  .area:nth-child(odd) { margin-right:30px; }
  .area:nth-child(even) { margin-left:30px; }
  .area span:first-child { color:var(--muted); font-size:.68rem; }
  .area strong { font-weight:500; }
  @media (max-width:750px) {
    .hero { grid-template-columns:1fr; gap:35px; padding:70px 0; }
    .hero-note { max-width:520px; }
    .area-grid { grid-template-columns:1fr; }
    .area:nth-child(odd), .area:nth-child(even) { margin:0; }
  }
</style>
