---
import BaseLayout from '../layouts/BaseLayout.astro';
const articles = [
  {
    title: 'Should We Use More Air Conditioning to Fight Climate Change?',
    slug: 'air-conditioning-climate-change',
    category: 'Energy & Climate',
    date: '16 August 2026',
    excerpt: 'A first essay on the uncomfortable relationship between rising temperatures, cooling demand and energy efficiency.'
  },
  {
    title: 'Green Hydrogen: Promise, Limits & Reality',
    slug: 'green-hydrogen-promise-limits-reality',
    category: 'Energy & Climate',
    date: 'Coming soon',
    excerpt: 'Notes on where green hydrogen makes sense—and where it may not.'
  }
];
---
<BaseLayout title="The Working Margin — Bagus Bachtiar" description="Writing by Bagus Bachtiar on energy, climate, impact, personal development, essays and ideas.">
  <section class="hero">
    <p class="eyebrow">Writing by Bagus Bachtiar</p>
    <h1>The Working<br /><em>Margin</em></h1>
    <p class="intro">Notes on energy, climate, impact, growth, and the ideas in between.</p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected writing</h2>
      <a href="/writing/">View all →</a>
    </div>

    <div class="articles">
      {articles.map((article) => (
        <article class="article-card">
          <div class="meta">{article.category} · {article.date}</div>
          {article.date === 'Coming soon' ? (
            <h3>{article.title}</h3>
          ) : (
            <h3><a href={`/writing/${article.slug}/`}>{article.title}</a></h3>
          )}
          <p>{article.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="manifesto">
    <p class="eyebrow">A note</p>
    <p>I write to understand things better: systems, choices, work, development, and the questions that sit between them.</p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 100px 0 110px; max-width: 780px; }
  .hero h1 { font-size: clamp(3.6rem, 9vw, 7rem); margin: 18px 0 26px; letter-spacing: -.04em; }
  .hero h1 em { color: var(--accent); }
  .intro { max-width: 560px; font-size: 1.25rem; color: var(--muted); }
  .section { border-top: 1px solid var(--line); padding: 55px 0 0; }
  .section-head { display:flex; justify-content:space-between; align-items:baseline; }
  .section-head h2 { font-size: 1.7rem; }
  .articles { margin-top: 20px; }
  .article-card { padding: 30px 0; border-bottom: 1px solid var(--line); max-width: 820px; }
  .meta { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; }
  .article-card h3 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 10px 0 10px; }
  .article-card p { color: var(--muted); max-width: 680px; margin: 0; }
  .manifesto { max-width: 680px; padding: 90px 0 20px; }
  .manifesto > p:last-child { font: 1.35rem/1.6 "Libre Baskerville", Georgia, serif; }
</style>
