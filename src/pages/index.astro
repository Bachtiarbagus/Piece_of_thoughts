---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts.find(p => p.data.featured) ?? posts[0];
const latest = posts.filter(p => p.id !== featured?.id).slice(0, 4);
const categories = [
  'Energy & Climate',
  'Impact',
  'Personal Development',
  'Essays & Ideas'
];
---

<BaseLayout
  title="The Working Margin — Bagus Bachtiar"
  description="Writing by Bagus Bachtiar on energy, climate, impact, growth and ideas."
>
  <section class="hero">
    <p class="eyebrow">A personal publication by Bagus Bachtiar</p>

    <h1>The Working <em>Margin</em></h1>

    <p class="dek">
      Notes on energy, climate, impact, growth, and the questions in between.
    </p>
  </section>

  {featured && (
    <section class="featured">
      <div class="eyebrow">Featured writing</div>

      <a href={`/writing/${featured.id}/`} class="feature-link">
        <div class="meta">
          {featured.data.category} ·
          {featured.data.date.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          })}
        </div>

        <h2>{featured.data.title}</h2>

        <p>{featured.data.description}</p>

        <span class="read">Read essay →</span>
      </a>
    </section>
  )}

  {latest.length > 0 && (
    <section class="latest">
      <div class="section-head">
        <h2>Latest</h2>
        <a href="/writing/">All writing →</a>
      </div>

      {latest.map(post => (
        <article>
          <div class="meta">
            {post.data.category} ·
            {post.data.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            })}
          </div>

          <h3>
            <a href={`/writing/${post.id}/`}>
              {post.data.title}
            </a>
          </h3>

          <p>{post.data.description}</p>
        </article>
      ))}
    </section>
  )}

  <section class="explore">
    <div class="eyebrow">Explore</div>

    <div class="category-grid">
      {categories.map(category => (
        <a href={`/writing/category/${encodeURIComponent(category)}/`}>
          <span>{category}</span>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="closing">
    <p class="eyebrow">Why this exists</p>

    <p>
      I write to understand things better: systems, choices, work,
      development, and the questions that sit between them.
    </p>
  </section>
</BaseLayout>

<style>
.hero {
  padding: 105px 0 95px;
  max-width: 850px;
}

.hero h1 {
  font-size: clamp(3.5rem, 8.5vw, 7rem);
  letter-spacing: -.055em;
  margin: 16px 0 25px;
}

.hero h1 em {
  color: var(--accent);
  font-style: normal;
}

.dek {
  font-size: 1.28rem;
  color: var(--muted);
  max-width: 650px;
}

.featured {
  border-top: 1px solid var(--line);
  padding: 42px 0 65px;
}

.feature-link {
  display: block;
  max-width: 850px;
}

.feature-link h2 {
  font-size: clamp(2rem, 4.5vw, 3.6rem);
  letter-spacing: -.025em;
  margin: 13px 0;
}

.feature-link p {
  font-size: 1.08rem;
  color: var(--muted);
  max-width: 690px;
}

.read {
  display: inline-block;
  margin-top: 10px;
  font-size: .82rem;
  font-weight: 600;
}

.latest {
  border-top: 1px solid var(--line);
  padding: 42px 0;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-head h2 {
  font-size: 1.8rem;
}

.section-head a {
  font-size: .82rem;
}

.latest article {
  max-width: 850px;
  padding: 27px 0;
  border-bottom: 1px solid var(--line);
}

.latest h3 {
  font-size: 1.65rem;
  margin: 8px 0;
}

.latest p {
  color: var(--muted);
  margin: 0;
}

.explore {
  padding: 75px 0 20px;
  border-bottom: 1px solid var(--line);
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-top: 15px;
}

.category-grid a {
  padding: 22px 0;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  font-family: "Libre Baskerville", Georgia, serif;
  font-size: 1.15rem;
  padding-right: 20px;
}

.category-grid a:nth-child(odd) {
  margin-right: 28px;
}

.category-grid a:nth-child(even) {
  margin-left: 28px;
}

.category-grid b {
  font-family: "DM Sans", sans-serif;
  font-weight: 400;
  color: var(--muted);
}

.closing {
  max-width: 700px;
  padding: 85px 0 20px;
}

.closing p:last-child {
  font: 1.35rem/1.65 "Libre Baskerville", Georgia, serif;
}

@media (max-width: 650px) {
  .hero {
    padding: 75px 0;
  }

  .category-grid {
    grid-template-columns: 1fr;
  }

  .category-grid a:nth-child(odd),
  .category-grid a:nth-child(even) {
    margin: 0;
  }

  .feature-link h2 {
    font-size: 2rem;
  }
}
</style>
